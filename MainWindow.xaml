<ui:FluentWindow x:Class="TrashAll.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:TrashAll.ViewModels"
        xmlns:helpers="clr-namespace:TrashAll.Helpers"
        mc:Ignorable="d"
        Title="TrashAll - Triagem e Limpeza de Arquivos"
        Height="820" Width="1240"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <helpers:NullToVisibilityConverter x:Key="NullToVis" />
        <helpers:NotNullToVisibilityConverter x:Key="NotNullToVis" />
        <helpers:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <helpers:NotEmptyStringToVisibilityConverter x:Key="NotEmptyStringToVis" />
    </Window.Resources>

    <Grid Background="#0B0D13">
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#00000000" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <TextBlock Text="🗑️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="TrashAll" FontWeight="Bold" FontSize="13" Foreground="#E6EDF3" VerticalAlignment="Center" />
                <TextBlock Text="• Limpeza &amp; Triagem Completa" FontSize="12" Foreground="#8B949E" VerticalAlignment="Center" Margin="6,0,0,0" />
            </StackPanel>

            <TextBlock Grid.Column="1" Text="{Binding CurrentFolderPath, Mode=OneWay}" 
                       Foreground="#7D8590" FontSize="12" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Margin="24,0,24,0" />

            <ui:TitleBar Grid.Column="2" Padding="0" />
        </Grid>

        <Border Grid.Row="1" Background="#12151E" BorderBrush="#1F2533" BorderThickness="0,1,0,1" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnOpenFolder" 
                            Content="📁  Escolher Pasta" 
                            Click="BtnOpenFolder_Click"
                            Background="#1A202D" Foreground="#F0F6FC" BorderBrush="#333E56" BorderThickness="1"
                            FontWeight="SemiBold" FontSize="12"
                            Padding="14,7" Cursor="Hand" Margin="0,2,12,2" />

                    <CheckBox Content="Incluir subpastas" 
                              IsChecked="{Binding IncludeSubfolders, Mode=TwoWay}"
                              Foreground="#9DA7B8" FontSize="12" VerticalAlignment="Center"
                              Margin="0,2,14,2" />

                    <Rectangle Width="1" Height="20" Fill="#242B3B" Margin="0,2,14,2" VerticalAlignment="Center" />

                    <RadioButton x:Name="RbVisualizer" Content="👁️ Visualizador" 
                                 IsChecked="{Binding IsVisualizerMode, Mode=TwoWay}"
                                 Click="RbVisualizer_Click"
                                 GroupName="ViewMode" Style="{StaticResource {x:Type ToggleButton}}"
                                 Background="#161A24" Foreground="#E6EDF3" BorderBrush="#272F42"
                                 Height="32" Padding="12,0" Margin="0,2,4,2" FontWeight="SemiBold" FontSize="12" Cursor="Hand" />

                    <RadioButton x:Name="RbList" Content="📋 Modo Lista" 
                                 IsChecked="{Binding IsListViewMode, Mode=TwoWay}"
                                 Click="RbList_Click"
                                 GroupName="ViewMode" Style="{StaticResource {x:Type ToggleButton}}"
                                 Background="#161A24" Foreground="#E6EDF3" BorderBrush="#272F42"
                                 Height="32" Padding="12,0" Margin="0,2,14,2" FontWeight="SemiBold" FontSize="12" Cursor="Hand" />

                    <Rectangle Width="1" Height="20" Fill="#242B3B" Margin="0,2,14,2" VerticalAlignment="Center" />

                    <TextBlock Text="Ordem:" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,2,6,2" FontSize="12" />
                    <ComboBox SelectedValue="{Binding SelectedSort, Mode=TwoWay}" 
                              SelectedValuePath="Content"
                              Width="145" Height="32" Margin="0,2,14,2" VerticalAlignment="Center" FontSize="12">
                        <ComboBoxItem Content="Maior Tamanho" IsSelected="True" />
                        <ComboBoxItem Content="Mais Recente" />
                        <ComboBoxItem Content="Nome (A-Z)" />
                    </ComboBox>
                </WrapPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0,0,0">
                    <Border Background="#151924" BorderBrush="#272F42" BorderThickness="1" CornerRadius="6" Height="32" Width="260" Padding="8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0" Foreground="#F0F6FC" FontSize="12"
                                     VerticalAlignment="Center" CaretBrush="#38BDF8" />
                            <Button Grid.Column="2" Content="✕" Command="{Binding ClearSearchCommand}"
                                    Background="Transparent" Foreground="#8B949E" BorderThickness="0" Cursor="Hand" Padding="4,0"
                                    Visibility="{Binding SearchQuery, Converter={StaticResource NotEmptyStringToVis}}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#0C0E14" BorderBrush="#1C212E" BorderThickness="0,0,0,1" Padding="14,6">
            <StackPanel Orientation="Vertical">

                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,5">
                    <TextBlock Text="Filtrar por:" Foreground="#7A8498" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />

                    <Button Command="{Binding SetCategoryCommand}" CommandParameter="Todos"
                            Background="#1E2330" Foreground="#F0F6FC" BorderBrush="#31394D" BorderThickness="1"
                            Padding="10,4" Margin="0,2,6,2" Cursor="Hand" FontSize="11" FontWeight="SemiBold">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Todos (" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CountTotal, Mode=OneWay}" FontWeight="Bold" Foreground="#F0F6FC" VerticalAlignment="Center" />
                            <TextBlock Text=")" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding SetCategoryCommand}" CommandParameter="Imagens"
                            Background="#161A24" Foreground="#CBD5E1" BorderBrush="#252C3D" BorderThickness="1"
                            Padding="8,4" Margin="0,2,6,2" Cursor="Hand" FontSize="11">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🖼️ Imagens (" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CountImages, Mode=OneWay}" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" />
                            <TextBlock Text=")" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding SetCategoryCommand}" CommandParameter="Vídeos"
                            Background="#161A24" Foreground="#CBD5E1" BorderBrush="#252C3D" BorderThickness="1"
                            Padding="8,4" Margin="0,2,6,2" Cursor="Hand" FontSize="11">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🎬 Vídeos (" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CountVideos, Mode=OneWay}" FontWeight="Bold" Foreground="#A855F7" VerticalAlignment="Center" />
                            <TextBlock Text=")" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding SetCategoryCommand}" CommandParameter="Executáveis"
                            Background="#161A24" Foreground="#CBD5E1" BorderBrush="#252C3D" BorderThickness="1"
                            Padding="8,4" Margin="0,2,6,2" Cursor="Hand" FontSize="11">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚙️ Executáveis (" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CountExecutables, Mode=OneWay}" FontWeight="Bold" Foreground="#F59E0B" VerticalAlignment="Center" />
                            <TextBlock Text=")" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding SetCategoryCommand}" CommandParameter="Compactados"
                            Background="#161A24" Foreground="#CBD5E1" BorderBrush="#252C3D" BorderThickness="1"
                            Padding="8,4" Margin="0,2,6,2" Cursor="Hand" FontSize="11">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📦 Compactados (" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CountArchives, Mode=OneWay}" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center" />
                            <TextBlock Text=")" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding SetCategoryCommand}" CommandParameter="Documentos"
                            Background="#161A24" Foreground="#CBD5E1" BorderBrush="#252C3D" BorderThickness="1"
                            Padding="8,4" Margin="0,2,6,2" Cursor="Hand" FontSize="11">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📄 Documentos &amp; PDF (" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CountDocuments, Mode=OneWay}" FontWeight="Bold" Foreground="#EC4899" VerticalAlignment="Center" />
                            <TextBlock Text=")" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding SetCategoryCommand}" CommandParameter="Duplicados"
                            Background="#241424" Foreground="#F472B6" BorderBrush="#5B1E48" BorderThickness="1"
                            Padding="8,4" Margin="0,2,6,2" Cursor="Hand" FontSize="11" FontWeight="SemiBold">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="👯 Duplicados (" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CountDuplicates, Mode=OneWay}" FontWeight="Bold" Foreground="#F472B6" VerticalAlignment="Center" />
                            <TextBlock Text=")" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding SetCategoryCommand}" CommandParameter="Outros"
                            Background="#161A24" Foreground="#CBD5E1" BorderBrush="#252C3D" BorderThickness="1"
                            Padding="8,4" Margin="0,2,6,2" Cursor="Hand" FontSize="11">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📁 Outros (" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CountOthers, Mode=OneWay}" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" />
                            <TextBlock Text=")" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Tamanho:" Foreground="#7A8498" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />

                        <Button Command="{Binding SetSizeFilterCommand}" CommandParameter="Todos" Content="Todos"
                                Background="#161A24" Foreground="#CBD5E1" BorderBrush="#252C3D" BorderThickness="1"
                                Padding="8,3" Margin="0,2,5,2" Cursor="Hand" FontSize="11" />

                        <Button Command="{Binding SetSizeFilterCommand}" CommandParameter="> 1 GB" Content="> 1 GB"
                                Background="#261214" Foreground="#F87171" BorderBrush="#541B20" BorderThickness="1"
                                Padding="8,3" Margin="0,2,5,2" Cursor="Hand" FontSize="11" FontWeight="SemiBold" />

                        <Button Command="{Binding SetSizeFilterCommand}" CommandParameter="> 100 MB" Content="> 100 MB"
                                Background="#261C12" Foreground="#FBBF24" BorderBrush="#543815" BorderThickness="1"
                                Padding="8,3" Margin="0,2,5,2" Cursor="Hand" FontSize="11" />

                        <Button Command="{Binding SetSizeFilterCommand}" CommandParameter="> 10 MB" Content="> 10 MB"
                                Background="#12201C" Foreground="#34D399" BorderBrush="#184439" BorderThickness="1"
                                Padding="8,3" Margin="0,2,5,2" Cursor="Hand" FontSize="11" />

                        <Button Command="{Binding SetSizeFilterCommand}" CommandParameter="&lt; 5 MB" Content="&lt; 5 MB"
                                Background="#161A24" Foreground="#94A3B8" BorderBrush="#252C3D" BorderThickness="1"
                                Padding="8,3" Margin="0,2,5,2" Cursor="Hand" FontSize="11" />
                    </WrapPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#161D2B" BorderBrush="#263854" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Filtro Ativo: " Foreground="#8B949E" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SelectedCategory}" Foreground="#38BDF8" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Border Visibility="{Binding DuplicateWastedText, Converter={StaticResource NotEmptyStringToVis}}"
                                Background="#2D1224" BorderBrush="#6B2154" BorderThickness="1" CornerRadius="4" Padding="8,3">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Duplicados: " Foreground="#F472B6" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DuplicateWastedText}" Foreground="#F472B6" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

            </StackPanel>
        </Border>

        <Grid Grid.Row="3" Background="#080A0E">

            <Border Visibility="{Binding IsUndoToastVisible, Converter={StaticResource BoolToVis}}"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Background="#E6101626" BorderBrush="#3B82F6" BorderThickness="1.5"
                    CornerRadius="10" Padding="18,10" Margin="0,0,0,24" Panel.ZIndex="999">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.8" Color="#000000" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding UndoToastMessage}" Foreground="#F0F6FC" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <Button Content="↩️ Desfazer (Ctrl+Z)"
                            Command="{Binding UndoDeleteCommand}"
                            Background="#1D4ED8" Foreground="#FFFFFF" BorderBrush="#3B82F6" BorderThickness="1"
                            Padding="14,6" FontWeight="Bold" FontSize="12" Cursor="Hand" />
                    <Button Content="✕"
                            Command="{Binding HideUndoToastCommand}"
                            Background="Transparent" Foreground="#94A3B8" BorderThickness="0"
                            Padding="8,4" Margin="8,0,0,0" Cursor="Hand" FontSize="12" />
                </StackPanel>
            </Border>

            <Grid Visibility="{Binding IsListViewMode, Converter={StaticResource InverseBoolToVis}}">

                <Border Visibility="{Binding CurrentItem, Converter={StaticResource NullToVis}}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#10131B" BorderBrush="#1F2535" BorderThickness="1"
                        CornerRadius="12" Padding="40,32" MaxWidth="540">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📂" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,14" />
                        <TextBlock Text="Nenhum arquivo na visualização" FontWeight="Bold" FontSize="17" Foreground="#F0F6FC" HorizontalAlignment="Center" Margin="0,0,0,6" />
                        <TextBlock Text="Escolha uma pasta ou mude a categoria de filtro acima." FontSize="12" Foreground="#8B949E" HorizontalAlignment="Center" Margin="0,0,0,24" />
                        
                        <Border Background="#141824" BorderBrush="#232B3E" BorderThickness="1" CornerRadius="8" Padding="20,16" Width="440">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Atalhos Rápidos de Teclado" FontWeight="Bold" Foreground="#C9D1D9" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,14" />
                                
                                <Grid HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Grid.Column="0" Background="#1C2333" BorderBrush="#2F3B56" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,2,10,4" HorizontalAlignment="Stretch">
                                        <TextBlock Text="D  ou  Seta Direita" Foreground="#79C0FF" FontSize="11" FontWeight="Bold" TextAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Próximo arquivo" Foreground="#8B949E" FontSize="12" VerticalAlignment="Center" Margin="0,2,0,4" />

                                    <Border Grid.Row="1" Grid.Column="0" Background="#1C2333" BorderBrush="#2F3B56" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,2,10,4" HorizontalAlignment="Stretch">
                                        <TextBlock Text="A  ou  Seta Esquerda" Foreground="#79C0FF" FontSize="11" FontWeight="Bold" TextAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Arquivo anterior" Foreground="#8B949E" FontSize="12" VerticalAlignment="Center" Margin="0,2,0,4" />

                                    <Border Grid.Row="2" Grid.Column="0" Background="#331416" BorderBrush="#5E1D22" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,2,10,2" HorizontalAlignment="Stretch">
                                        <TextBlock Text="Delete  ou  X" Foreground="#F87171" FontSize="11" FontWeight="Bold" TextAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Mover para a Lixeira segura" Foreground="#F87171" FontSize="12" VerticalAlignment="Center" Margin="0,2" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Grid Visibility="{Binding IsImageMode, Converter={StaticResource BoolToVis}}">
                    <Image x:Name="ImageViewer" 
                           Source="{Binding CurrentImageSource, Mode=OneWay}" 
                           Stretch="Uniform" 
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Margin="10" />

                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" 
                            Background="#D9161B22" BorderBrush="#30363D" BorderThickness="1"
                            CornerRadius="8" Padding="12,6" Margin="0,16,16,0"
                            Visibility="{Binding IsPdfItem, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📄" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Documento PDF" FontWeight="Bold" Foreground="#F0F6FC" FontSize="12" VerticalAlignment="Center" />
                            <Border Background="#238636" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                <TextBlock Text="1ª Página" FontWeight="SemiBold" Foreground="#FFFFFF" FontSize="10" />
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Visibility="{Binding IsVideoMode, Converter={StaticResource BoolToVis}}">
                    <MediaElement x:Name="VideoPlayer"
                                  LoadedBehavior="Manual"
                                  UnloadedBehavior="Stop"
                                  ScrubbingEnabled="True"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Margin="10"
                                  MediaOpened="VideoPlayer_MediaOpened"
                                  MediaEnded="VideoPlayer_MediaEnded" />

                    <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" 
                            Background="#E611141C" CornerRadius="10" Padding="16,8" Margin="0,0,0,24"
                            BorderBrush="#2C3446" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnPlayPause" Content="⏸️" 
                                    Click="BtnPlayPause_Click" 
                                    Background="#1F2430" Foreground="#F0F6FC" BorderBrush="#353D52" BorderThickness="1"
                                    Width="40" Height="32" Padding="0" Margin="0,0,12,0" Cursor="Hand" />
                            
                            <Slider x:Name="VideoTimeline" Width="280" VerticalAlignment="Center" 
                                    Minimum="0" Maximum="1"
                                    PreviewMouseDown="VideoTimeline_PreviewMouseDown"
                                    PreviewMouseUp="VideoTimeline_PreviewMouseUp"
                                    ValueChanged="VideoTimeline_ValueChanged" Margin="0,0,14,0" />

                            <TextBlock x:Name="TxtVideoTime" Text="00:00 / 00:00" 
                                       Foreground="#C9D1D9" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Visibility="{Binding IsZipMode, Converter={StaticResource BoolToVis}}">
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="#11141C" BorderBrush="#252C3D" BorderThickness="1.5"
                            CornerRadius="16" Padding="32,24" Width="760" MaxHeight="540">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                                    <TextBlock Text="📦" FontSize="26" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding CurrentZipPreview.ZipFileName, Mode=OneWay}" 
                                               FontWeight="Bold" FontSize="18" Foreground="#F0F6FC" 
                                               TextTrimming="CharacterEllipsis" MaxWidth="520" VerticalAlignment="Center" />
                                    <Border Background="#1C2826" BorderBrush="#2D4F46" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="12,0,0,0">
                                        <TextBlock Text="{Binding CurrentItem.FormattedSize, Mode=OneWay}" Foreground="#34D399" FontSize="12" FontWeight="Bold" />
                                    </Border>
                                </StackPanel>

                                <TextBlock Foreground="#8B949E" FontSize="12">
                                    <Run Text="Conteúdo:" FontWeight="SemiBold" Foreground="#CBD5E1" />
                                    <Run Text="{Binding CurrentZipPreview.TotalEntries, Mode=OneWay}" FontWeight="Bold" Foreground="#38BDF8" />
                                    <Run Text=" itens no pacote • Tamanho descompactado: " />
                                    <Run Text="{Binding CurrentZipPreview.FormattedTotalSize, Mode=OneWay}" FontWeight="Bold" Foreground="#F59E0B" />
                                </TextBlock>
                            </StackPanel>

                            <Border Grid.Row="1" Background="#0A0C11" BorderBrush="#1F2533" BorderThickness="1" CornerRadius="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="30" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Background="#141822" BorderBrush="#1E2536" BorderThickness="0,0,0,1" Padding="12,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="130" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="1" Text="Nome / Caminho Interno" Foreground="#7D8590" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="Tamanho" Foreground="#7D8590" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="Data Modificação" Foreground="#7D8590" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <ListView Grid.Row="1" ItemsSource="{Binding CurrentZipPreview.Entries, Mode=OneWay}"
                                              Background="Transparent" BorderThickness="0"
                                              Foreground="#E2E8F0"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="100" />
                                                        <ColumnDefinition Width="130" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding Icon, Mode=OneWay}" FontSize="13" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding RelativePath, Mode=OneWay}" 
                                                               Foreground="#E2E8F0" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="2" Text="{Binding FormattedSize, Mode=OneWay}" 
                                                               Foreground="#34D399" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="3" Text="{Binding FormattedDate, Mode=OneWay}" 
                                                               Foreground="#64748B" FontSize="11" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>

                                    <TextBlock Grid.Row="2" Text="{Binding CurrentZipPreview.MoreEntriesNotice, Mode=OneWay}"
                                               Foreground="#64748B" FontSize="11" Margin="12,4,12,6" FontStyle="Italic"
                                               Visibility="{Binding CurrentZipPreview.HasMoreEntries, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                                <Button Content="📂 Abrir no Explorer" 
                                        Command="{Binding OpenInExplorerCommand}"
                                        Background="#1C2232" Foreground="#CBD5E1" BorderBrush="#2E3850" BorderThickness="1"
                                        Padding="14,8" Margin="0,0,10,0" Cursor="Hand" FontWeight="SemiBold" />

                                <Button Content="🗑️ Mover ZIP para Lixeira (Del)" 
                                        Command="{Binding DeleteCurrentCommand}"
                                        Background="#B62324" Foreground="#FFFFFF" BorderBrush="#DA3633" BorderThickness="1"
                                        Padding="16,8" Cursor="Hand" FontWeight="Bold" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Visibility="{Binding IsGenericFileMode, Converter={StaticResource BoolToVis}}">
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="#11141C" BorderBrush="#252C3D" BorderThickness="1.5"
                            CornerRadius="16" Padding="40,32" MaxWidth="600">
                        <StackPanel HorizontalAlignment="Center">
                            <Image Source="{Binding CurrentItem.FileIcon, Mode=OneWay}" 
                                   Width="64" Height="64" HorizontalAlignment="Center" Margin="0,0,0,18" />
                            
                            <TextBlock Text="{Binding CurrentItem.FileName, Mode=OneWay}" 
                                       FontWeight="Bold" FontSize="18" Foreground="#F0F6FC" 
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,8" />
                            
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <Border Background="#1E2436" CornerRadius="6" Padding="8,3" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding CurrentItem.CategoryName, Mode=OneWay}" Foreground="#38BDF8" FontSize="12" FontWeight="Bold" />
                                </Border>
                                <Border Background="#1C2130" CornerRadius="6" Padding="8,3">
                                    <TextBlock Text="{Binding CurrentItem.FormattedSize, Mode=OneWay}" Foreground="#34D399" FontSize="12" FontWeight="Bold" />
                                </Border>
                            </StackPanel>

                            <TextBlock Text="{Binding CurrentItem.DirectoryPath, Mode=OneWay}" 
                                       Foreground="#64748B" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,24" />

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="📂 Abrir no Explorer" 
                                        Command="{Binding OpenInExplorerCommand}"
                                        Background="#1C2232" Foreground="#CBD5E1" BorderBrush="#2E3850" BorderThickness="1"
                                        Padding="16,8" Margin="0,0,12,0" Cursor="Hand" FontWeight="SemiBold" />

                                <Button Content="🗑️ Mover para Lixeira (Del)" 
                                        Command="{Binding DeleteCurrentCommand}"
                                        Background="#B62324" Foreground="#FFFFFF" BorderBrush="#DA3633" BorderThickness="1"
                                        Padding="18,8" Cursor="Hand" FontWeight="Bold" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

            </Grid>

            <Grid Visibility="{Binding IsListViewMode, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#0F121A" BorderBrush="#1C2230" BorderThickness="0,0,0,1" Padding="28,8,28,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="1" Text="Nome do Arquivo" Foreground="#7D8590" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0" />
                        <TextBlock Grid.Column="2" Text="Categoria" Foreground="#7D8590" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="Tamanho" Foreground="#7D8590" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="Modificado em" Foreground="#7D8590" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="5" Text="Ações" Foreground="#7D8590" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                </Border>

                <ListView Grid.Row="1" x:Name="FileListView"
                          ItemsSource="{Binding Items, Mode=OneWay}"
                          SelectedItem="{Binding CurrentItem, Mode=TwoWay}"
                          Background="#080A0E" BorderThickness="0"
                          Foreground="#E2E8F0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">

                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="10,8" />
                            <Setter Property="Margin" Value="14,2,14,2" />
                            <Setter Property="Background" Value="#10131B" />
                            <Setter Property="BorderBrush" Value="#1E2433" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#181D2A" />
                                    <Setter Property="BorderBrush" Value="#2F3950" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#1F293D" />
                                    <Setter Property="BorderBrush" Value="#38BDF8" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>

                                <Image Grid.Column="0" Source="{Binding FileIcon, Mode=OneWay}" 
                                       Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Left" />

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,12,0">
                                    <TextBlock Text="{Binding FileName, Mode=OneWay}" 
                                               FontWeight="SemiBold" FontSize="13" Foreground="#F1F5F9"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="450" />
                                    <Border Visibility="{Binding IsDuplicate, Converter={StaticResource BoolToVis}}"
                                            Background="#311B2C" BorderBrush="#831843" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding DuplicateBadgeText, Mode=OneWay}" Foreground="#F472B6" FontSize="10" FontWeight="Bold" />
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#1A2030" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="{Binding CategoryName, Mode=OneWay}" Foreground="#79C0FF" FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>

                                <TextBlock Grid.Column="3" Text="{Binding FormattedSize, Mode=OneWay}" 
                                           FontWeight="Bold" Foreground="#34D399" FontSize="12"
                                           VerticalAlignment="Center" />

                                <TextBlock Grid.Column="4" Text="{Binding FormattedDate, Mode=OneWay}" 
                                           Foreground="#8B949E" FontSize="12"
                                           VerticalAlignment="Center" />

                                <Button Grid.Column="5" Content="🗑️ Apagar" 
                                        Click="BtnDeleteRow_Click" Tag="{Binding}"
                                        Background="#3D1416" Foreground="#F87171" BorderBrush="#5C1D20" BorderThickness="1"
                                        Padding="10,4" FontSize="11" FontWeight="SemiBold" Cursor="Hand" HorizontalAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

        </Grid>

        <Border Grid.Row="4" Background="#11141C" BorderBrush="#1F2535" BorderThickness="0,1,0,0" Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding CurrentItem, Converter={StaticResource NullToVis}}">
                        <TextBlock Text="📊 " FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CounterText, Mode=OneWay}" Foreground="#8B949E" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text=" arquivos listados" Foreground="#64748B" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding CurrentItem, Converter={StaticResource NotNullToVis}}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="{Binding CurrentItem.FileName, Mode=OneWay}" FontWeight="Bold" FontSize="13" Foreground="#F0F6FC" TextTrimming="CharacterEllipsis" MaxWidth="340" VerticalAlignment="Center" />
                            <Border Background="#1C2438" BorderBrush="#2B3A5A" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                <TextBlock Text="{Binding CurrentItem.Extension, Mode=OneWay}" Foreground="#79C0FF" FontSize="10" FontWeight="Bold" />
                            </Border>
                        </StackPanel>
                        <TextBlock Foreground="#8B949E" FontSize="11">
                            <Run Text="{Binding CurrentItem.FormattedSize, Mode=OneWay}" FontWeight="Bold" Foreground="#34D399" />
                            <Run Text=" • " />
                            <Run Text="{Binding CurrentItem.FormattedDate, Mode=OneWay}" />
                            <Run Text=" • Item " />
                            <Run Text="{Binding CounterText, Mode=OneWay}" FontWeight="SemiBold" Foreground="#CBD5E1" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    
                    <Button Content="◀  Anterior (A)" 
                            Command="{Binding PreviousCommand}"
                            Background="#181D29" Foreground="#E6EDF3" BorderBrush="#2A3347" BorderThickness="1"
                            Height="38" Padding="14,0" Margin="0,0,8,0"
                            FontWeight="SemiBold" FontSize="12" Cursor="Hand" />

                    <Button Content="🗑️  Lixeira (Del)" 
                            Command="{Binding DeleteCurrentCommand}"
                            Background="#C52227" Foreground="#FFFFFF" BorderBrush="#E03131" BorderThickness="1"
                            Height="38" Padding="18,0" Margin="0,0,8,0"
                            FontWeight="Bold" FontSize="12" Cursor="Hand" />

                    <Button Content="Próximo (D)  ▶" 
                            Command="{Binding NextCommand}"
                            Background="#181D29" Foreground="#E6EDF3" BorderBrush="#2A3347" BorderThickness="1"
                            Height="38" Padding="14,0" Margin="0,0,8,0"
                            FontWeight="SemiBold" FontSize="12" Cursor="Hand" />

                    <Button Content="↩️  Desfazer (Ctrl+Z)" 
                            Command="{Binding UndoDeleteCommand}"
                            IsEnabled="{Binding CanUndo}"
                            Background="#192233" Foreground="#94A3B8" BorderBrush="#293952" BorderThickness="1"
                            Height="38" Padding="12,0"
                            FontWeight="SemiBold" FontSize="11" Cursor="Hand" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#102319" BorderBrush="#1C4A31" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="♻️ " FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding FreedSpaceText, Mode=OneWay}" Foreground="#34D399" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Button Content="📂  Abrir no Explorer" 
                            Command="{Binding OpenInExplorerCommand}"
                            Background="#181D29" Foreground="#CBD5E1" BorderBrush="#2A3347" BorderThickness="1"
                            Height="34" Padding="12,0" Cursor="Hand" FontSize="11" FontWeight="SemiBold"
                            Visibility="{Binding CurrentItem, Converter={StaticResource NotNullToVis}}" />
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</ui:FluentWindow>
